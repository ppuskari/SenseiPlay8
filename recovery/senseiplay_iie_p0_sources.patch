diff --git a/apps/senseiplay-iie/src/sensei8.s b/apps/senseiplay-iie/src/sensei8.s
new file mode 100644
index 0000000..92513a9
--- /dev/null
+++ b/apps/senseiplay-iie/src/sensei8.s
@@ -0,0 +1,349 @@
+********************************************************************************
+* Sensei8 P0 - four-channel 65C02 MOD proof-of-playback for a2fpga Enhanced
+* Based on SenseiPlay's tracker/DOC architecture; NEW 8-bit player code.
+* 6502-safe opcodes throughout, no 65816, GS toolsets, interrupts, or AUX RAM.
+* Copyright (c) 2026 Petar Puskarich / contributors, experimental prototype.
+*
+* Native DOC audio personality = 2; SLOT 4 $C0C0-$C0C9.
+* Playback requires an S8M0 module generated by tools/mod_to_s8m.py.
+* Assemble: merlin32 -V . src/sensei8.s
+* For P0 boot DOS 3.3 and BLOAD BIN at $2000, CALL 8192; any key stops.
+* DO NOT BLOAD over ProDOS 8 BASIC.SYSTEM at $2000 (it uses this RAM).
+********************************************************************************
+                org   $2000
+                typ   $06
+
+DOCCTL          equ   $C0C0
+DOCDATA         equ   $C0C1
+DOCPTR          equ   $C0C2
+DOCPTRHI        equ   $C0C3
+DOCID0          equ   $C0C4
+DOCID1          equ   $C0C5
+DOCID2          equ   $C0C6
+DOCMODE         equ   $C0C8
+RDVBL           equ   $C019
+KBD             equ   $C000
+KBDSTRB         equ   $C010
+COUT            equ   $FDED
+CROUT           equ   $FD8E
+ROWPTR          equ   $06
+BANKPTR         equ   $08
+
+Start           cld
+                lda   ROWPTR
+                sta   Saved06
+                lda   ROWPTR+1
+                sta   Saved07
+                lda   BANKPTR
+                sta   Saved08
+                lda   BANKPTR+1
+                sta   Saved09
+                lda   $C051            ; text mode
+                jsr   PrintTitle
+                jsr   ProbeDOC
+                bcc   ValidDOC
+                jsr   PrintNeedDOC
+                jmp   Finish
+ValidDOC        jsr   InitDOC
+                jsr   UploadSamples
+                jsr   PrepareSong
+MainLoop        lda   RowsLeft
+                ora   RowsLeft+1
+                beq   FinishedSong
+                jsr   PlayRow
+                jsr   WaitFrames
+                jsr   KeyPressed
+                bcs   FinishedSong
+                lda   RowsLeft
+                bne   RowDecLo
+                dec   RowsLeft+1
+RowDecLo        dec   RowsLeft
+                jmp   MainLoop
+FinishedSong    jsr   StopDOC
+Finish          lda   Saved06
+                sta   ROWPTR
+                lda   Saved07
+                sta   ROWPTR+1
+                lda   Saved08
+                sta   BANKPTR
+                lda   Saved09
+                sta   BANKPTR+1
+                rts
+
+PrintTitle      ldx   #$00
+PrTitleLoop     lda   TitleText,x
+                beq   PrTitleDone
+                ora   #$80
+                stx   PrintSavedX
+                jsr   COUT
+                ldx   PrintSavedX
+                inx
+                bne   PrTitleLoop
+PrTitleDone     jsr   CROUT
+                rts
+
+PrintNeedDOC    ldx   #$00
+PrFailLoop      lda   FailText,x
+                beq   PrFailDone
+                ora   #$80
+                stx   PrintSavedX
+                jsr   COUT
+                ldx   PrintSavedX
+                inx
+                bne   PrFailLoop
+PrFailDone      jsr   CROUT
+                rts
+
+* Detect a2fpga native DOC slot signature and current audio personality.
+* Carry clear only for A2 audio mode; A3 Shared can be supported later.
+ProbeDOC        lda   DOCID0
+                cmp   #$44             ; D
+                bne   ProbeFail
+                lda   DOCID1
+                cmp   #$4F             ; O
+                bne   ProbeFail
+                lda   DOCID2
+                cmp   #$43             ; C
+                bne   ProbeFail
+                lda   DOCMODE
+                cmp   #$A2             ; mode 2 = Native DOC
+                bne   ProbeFail
+                clc
+                rts
+ProbeFail       sec
+                rts
+
+* Y=register address, A=data; $C0C3 is kept at $00 for DOC registers.
+DOCWrite        sty   DOCPTR
+                sta   DOCDATA
+                rts
+
+InitDOC         lda   #$0F             ; DOC regs, global volume F
+                sta   DOCCTL
+                lda   #$00
+                sta   DOCPTRHI
+                ldx   #$00
+HaltInitLoop    txa
+                clc
+                adc   #$A0
+                tay
+                lda   #$01             ; halt before uploading samples
+                jsr   DOCWrite
+                inx
+                cpx   #$20             ; silence ALL 32 legacy voices
+                bne   HaltInitLoop
+                ldy   #$E1
+                lda   #$3E             ; 32 oscillators: native Tool222-like SR
+                jsr   DOCWrite
+                rts
+
+* SampleBank is a fully packed/ordered sound-RAM image with 0x80 gaps.
+* Memory upload via native GLU RAM auto-increment. Only bank 0 in P0.
+UploadSamples   lda   #$6F             ; RAM, AUTOINC, volume F
+                sta   DOCCTL
+                lda   #$00
+                sta   DOCPTR
+                sta   DOCPTRHI
+                lda   #<SampleBank
+                sta   BANKPTR
+                lda   #>SampleBank
+                sta   BANKPTR+1
+                lda   SampleBankLen
+                sta   BytesLeft
+                lda   SampleBankLen+1
+                sta   BytesLeft+1
+UploadLoop      lda   BytesLeft
+                ora   BytesLeft+1
+                beq   UploadDone
+                ldy   #$00
+                lda   (BANKPTR),y
+                sta   DOCDATA
+                inc   BANKPTR
+                bne   UploadNoCarry
+                inc   BANKPTR+1
+UploadNoCarry   lda   BytesLeft
+                bne   UploadDec
+                dec   BytesLeft+1
+UploadDec       dec   BytesLeft
+                jmp   UploadLoop
+UploadDone      lda   #$0F
+                sta   DOCCTL
+                lda   #$00
+                sta   DOCPTRHI
+                rts
+
+PrepareSong     lda   #<SongRows
+                sta   ROWPTR
+                lda   #>SongRows
+                sta   ROWPTR+1
+                lda   SongRowCount
+                sta   RowsLeft
+                lda   SongRowCount+1
+                sta   RowsLeft+1
+                rts
+
+* Each row: duration frames + 4 channel events (7 bytes each).
+* Event: FClo, FChi, WTP, RTS, volume, CTRL, flags.
+* flags: 0=unchanged, 1=retrigger, 2=cut (volume zero).
+PlayRow         ldy   #$00
+                lda   (ROWPTR),y
+                sta   FrameCount
+                inc   ROWPTR
+                bne   RowNoCarry
+                inc   ROWPTR+1
+RowNoCarry      ldx   #$00
+ReadChan        ldy   #$00
+                lda   (ROWPTR),y
+                sta   EvLo
+                iny
+                lda   (ROWPTR),y
+                sta   EvHi
+                iny
+                lda   (ROWPTR),y
+                sta   EvWTP
+                iny
+                lda   (ROWPTR),y
+                sta   EvRTS
+                iny
+                lda   (ROWPTR),y
+                sta   EvVol
+                iny
+                lda   (ROWPTR),y
+                sta   EvCtrl
+                iny
+                lda   (ROWPTR),y
+                sta   EvFlags
+                lda   EvFlags
+                and   #$01
+                beq   MaybeCut
+                jsr   StartVoice
+                jmp   NextChan
+MaybeCut        lda   EvFlags
+                and   #$02
+                beq   NextChan
+                jsr   CutVoice
+NextChan        clc
+                lda   ROWPTR
+                adc   #$07
+                sta   ROWPTR
+                bcc   ChanNoCarry
+                inc   ROWPTR+1
+ChanNoCarry     inx
+                cpx   #$04
+                bne   ReadChan
+                rts
+
+* X=channel. Halt/retrigger ensures each row's MOD note attacks.
+StartVoice      txa
+                clc
+                adc   #$A0
+                tay
+                lda   EvCtrl
+                ora   #$01
+                jsr   DOCWrite
+                txa
+                clc
+                adc   #$80
+                tay
+                lda   EvWTP
+                jsr   DOCWrite
+                txa
+                clc
+                adc   #$C0
+                tay
+                lda   EvRTS
+                jsr   DOCWrite
+                txa
+                tay
+                lda   EvLo
+                jsr   DOCWrite
+                txa
+                clc
+                adc   #$20
+                tay
+                lda   EvHi
+                jsr   DOCWrite
+                txa
+                clc
+                adc   #$40
+                tay
+                lda   EvVol
+                jsr   DOCWrite
+                txa
+                clc
+                adc   #$A0
+                tay
+                lda   EvCtrl
+                and   #$FE
+                jsr   DOCWrite
+                rts
+
+CutVoice        txa
+                clc
+                adc   #$40
+                tay
+                lda   #$00
+                jsr   DOCWrite
+                rts
+
+* 60 Hz Apple IIe VBL. Module preprocessor assigns each row 7/8 frames
+* at default ProTracker speed=6 BPM=125 (7.2 frames average).
+* P0 has no per-tick slide/vibrato/arpeggio updates.
+WaitFrames      ldx   FrameCount
+                beq   WaitDone
+WaitFrameLoop   jsr   WaitOneFrame
+                dex
+                bne   WaitFrameLoop
+WaitDone        rts
+WaitOneFrame    lda   RDVBL
+                bmi   WaitOneFrame
+VBLStart        lda   RDVBL
+                bpl   VBLStart
+                rts
+
+* Stop on any Apple II key for P0; TAB remains MCU menu toggle.
+KeyPressed      lda   KBD
+                bpl   NoKey
+                lda   KBDSTRB
+                sec
+                rts
+NoKey           clc
+                rts
+
+StopDOC         lda   #$0F
+                sta   DOCCTL
+                lda   #$00
+                sta   DOCPTRHI
+                ldx   #$00
+StopLoop        jsr   CutVoice
+                txa
+                clc
+                adc   #$A0
+                tay
+                lda   #$01
+                jsr   DOCWrite
+                inx
+                cpx   #$20             ; leave shared DOC clean on exit
+                bne   StopLoop
+                rts
+
+TitleText       asc   'SENSEI8 P0 - FOUR CHANNEL DOC',00
+FailText        asc   'SET A2FPGA AUDIO TO NATIVE DOC',00
+Saved06         db    0
+Saved07         db    0
+Saved08         db    0
+Saved09         db    0
+PrintSavedX     db    0
+BytesLeft       dw    0
+RowsLeft        dw    0
+FrameCount      db    0
+EvLo            db    0
+EvHi            db    0
+EvWTP           db    0
+EvRTS           db    0
+EvVol           db    0
+EvCtrl          db    0
+EvFlags         db    0
+
+* Generated from a real 4-channel MOD by the host converter.
+                put   module_data
